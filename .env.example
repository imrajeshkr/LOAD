# Copy to .env before building: pubspec.yaml ships .env as a Flutter asset, so
# a checkout without one cannot build at all. Values below are placeholders.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Server-side only — never read by the app, used by tool/db_*.sh
SERVICE_ROLE_SECRET=
GEMINI_API_KEY=
LOAD_SUPABASE_DB_PASSWORD=
